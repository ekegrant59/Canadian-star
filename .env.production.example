# Production environment — the values to paste into Coolify.
#
# THIS FILE IS A TEMPLATE. Do not fill it in and commit it, and do not ship a
# .env file to the server: Coolify holds the real values in its environment
# config, and .dockerignore keeps .env out of the image (verified: /app/.env
# does not exist in the built image).
#
# Replace every <ANGLE_BRACKET> placeholder. Nothing here should say localhost.
#
# ---------------------------------------------------------------------------
# BUILD vs RUNTIME — the distinction that breaks deployments
# ---------------------------------------------------------------------------
# Coolify lets you mark a variable as a "Build Variable". The rule:
#
#   NEXT_PUBLIC_*  -> MUST be marked as a build variable.
#                     Next inlines these into the JavaScript at build time.
#                     Setting one only at runtime does nothing: the string is
#                     already compiled into the bundle the browser downloads.
#
#   Everything else -> MUST NOT be a build variable.
#                     Secrets marked as build variables are baked into image
#                     layers, where anyone who can pull the image can read them.
#
# Verified: with NEXT_PUBLIC_APP_URL unset at build time, the literal
# "http://localhost:3000" fallback was compiled into the server bundle.


# ---------------------------------------------------------------------------
# Database — RUNTIME
# ---------------------------------------------------------------------------
# The internal hostname Coolify shows on the Postgres resource, NOT localhost
# and NOT a public IP. Postgres publishes no public port.
# Coolify's internal host is usually the service name or a generated id.
DATABASE_URL=postgresql://canadian_star:<DB_PASSWORD>@<COOLIFY_INTERNAL_PG_HOST>:5432/canadian_star

# Set to false only when running a migration by hand. Default true: the
# container migrates itself on start (scripts/entrypoint.sh).
RUN_MIGRATIONS_ON_START=true


# ---------------------------------------------------------------------------
# Auth — RUNTIME. Generate fresh; never reuse the development values.
# ---------------------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=<GENERATE_32_BYTE_BASE64>

# Public https origin. Magic links are built from this: if it is wrong, every
# sign-in email points somewhere that does not exist. No trailing slash.
BETTER_AUTH_URL=https://<YOUR_DOMAIN>

# Server-side pepper for hashing IPs before storage (PIPEDA).
# openssl rand -base64 32
# Set ONCE. Rotating it invalidates all existing IP-based fraud correlation.
IP_HASH_PEPPER=<GENERATE_32_BYTE_BASE64>

# Comma-separated. The ONLY path to a privileged account: there is no open
# registration on these roles. Compared after canonicalization, so
# Boss+tag@Gmail.com and boss@gmail.com are the same person.
# An empty ADMIN allowlist means nobody can administer the site.
ADMIN_EMAIL_ALLOWLIST=<admin@example.com>
JUDGE_EMAIL_ALLOWLIST=
REVIEWER_EMAIL_ALLOWLIST=


# ---------------------------------------------------------------------------
# Application — BUILD VARIABLE (see the note at the top)
# ---------------------------------------------------------------------------
# Same value as BETTER_AUTH_URL. Used for metadataBase, so canonical URLs, Open
# Graph tags and sitemaps depend on it. Wrong value = social previews and
# canonical links pointing at localhost. No trailing slash.
NEXT_PUBLIC_APP_URL=https://<YOUR_DOMAIN>


# ---------------------------------------------------------------------------
# Storage (Cloudinary) — Phase 3
# ---------------------------------------------------------------------------
# Cloud name is public: it appears in every delivery URL. It is NOT prefixed
# NEXT_PUBLIC_ because only server code reads it, and next.config.ts needs it
# at BUILD time to scope the image remotePattern. Mark it as a build variable
# AND a runtime variable.
CLOUDINARY_CLOUD_NAME=<your_cloud_name>

# RUNTIME ONLY. The secret signs uploads: treat it like a password. Never
# NEXT_PUBLIC_, never a build variable.
CLOUDINARY_API_KEY=<cloudinary_api_key>
CLOUDINARY_API_SECRET=<cloudinary_api_secret>


# ---------------------------------------------------------------------------
# Email (Resend) — Phase 3, RUNTIME
# ---------------------------------------------------------------------------
# Until this is set, magic-link sign-in THROWS in production by design, rather
# than silently logging the link to the console as it does in development.
RESEND_API_KEY=<resend_api_key>

# Must be a domain verified in Resend, not example.com.
EMAIL_FROM="The Next Great Canadian Country Star <noreply@<YOUR_DOMAIN>>"

# CASL requires sender identification and a real physical mailing address in
# every commercial message. Penalties reach $10M per violation for
# corporations. These are not placeholders to leave as-is.
EMAIL_SENDER_NAME="<Legal entity name>"
EMAIL_SENDER_ADDRESS="<Full physical mailing address>"


# ---------------------------------------------------------------------------
# Bot defense (Cloudflare Turnstile) — Phase 4
# ---------------------------------------------------------------------------
# Site key is public and inlined into the browser bundle: BUILD VARIABLE.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<turnstile_site_key>
# Secret key verifies tokens server-side: RUNTIME ONLY.
TURNSTILE_SECRET_KEY=<turnstile_secret_key>


# ---------------------------------------------------------------------------
# Cron (Coolify scheduled tasks) — RUNTIME
# ---------------------------------------------------------------------------
# Compared with timingSafeEqual by the cron route.
# openssl rand -base64 32
CRON_SECRET=<GENERATE_32_BYTE_BASE64>


# ---------------------------------------------------------------------------
# Not set here on purpose
# ---------------------------------------------------------------------------
# NODE_ENV   - the Dockerfile sets it to production.
# PORT       - the Dockerfile sets 3000; Coolify maps the domain to it.
# HOSTNAME   - the Dockerfile sets 0.0.0.0 so the server accepts container traffic.
