# DEVELOPMENT ONLY. Copy to .env for local work. Never commit .env.
#
# The localhost values below are correct for `docker compose up -d` and wrong
# for production. Do NOT copy this file to the server.
#
# For deployment use .env.production.example, which carries the real value
# shapes and marks each variable as a Coolify build or runtime variable. That
# distinction matters: NEXT_PUBLIC_* is inlined at build time, so setting it
# only at runtime silently leaves the wrong value compiled into the bundle.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local (docker compose). In Coolify this points at the internal service name,
# and Postgres must NOT publish a port to the public internet.
DATABASE_URL=postgresql://canadian_star:local_dev_password@localhost:5433/canadian_star

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_me_with_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side pepper for hashing IP addresses before storage (PIPEDA).
# Generate with: openssl rand -base64 32
# Changing this invalidates existing IP-based fraud correlation, so set it once.
IP_HASH_PEPPER=replace_me_with_openssl_rand_base64_32

# Comma-separated allowlist for privileged sign-in. No open registration on
# these roles, ever. Emails are compared after canonicalization.
ADMIN_EMAIL_ALLOWLIST=
JUDGE_EMAIL_ALLOWLIST=
REVIEWER_EMAIL_ALLOWLIST=

# ---------------------------------------------------------------------------
# Storage (Cloudinary) — Phase 3
# ---------------------------------------------------------------------------
# From the Cloudinary dashboard. The cloud name is public (it appears in every
# delivery URL); the API secret is NOT and must never be NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Email (Resend) — Phase 3
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="The Next Great Canadian Country Star <noreply@example.com>"
# CASL requires sender identification in every commercial message.
EMAIL_SENDER_NAME="Hellion Entertainment"
EMAIL_SENDER_ADDRESS="Physical mailing address required by CASL"

# ---------------------------------------------------------------------------
# Bot defense (Cloudflare Turnstile) — Phase 4
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Cron (Coolify scheduled tasks)
# ---------------------------------------------------------------------------
# Compared with timingSafeEqual. Generate with: openssl rand -base64 32
CRON_SECRET=replace_me_with_openssl_rand_base64_32
